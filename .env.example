# Copy to .env and fill in. .env is gitignored.

# Anthropic API key for clip detection (Phase 2+). The anthropic SDK and
# `clipper doctor` both read this directly from the environment.
ANTHROPIC_API_KEY=

# clipper config (CLIPPER_ prefix). Defaults are sized for the 8 GB M1 Air;
# uncomment and bump on the 24 GB M5 Pro.
# CLIPPER_WHISPER_MODEL=small          # small (Air) | medium | large-v3 (Pro)
# CLIPPER_WHISPER_COMPUTE_TYPE=int8
# CLIPPER_WORKER_CONCURRENCY=1
# CLIPPER_STORAGE_DIR=storage
# CLIPPER_DETECTOR_MODEL=claude-opus-4-8
# CLIPPER_DETECTOR_FALLBACK_MODEL=claude-sonnet-4-6
